PURRAI_DATABASE_URL=sqlite+aiosqlite:///./data/purrai.db
# 必填：Bot Token。仅允许所有者批准的自用和朋友群接入。
PURRAI_BOT_TOKEN=
# 填写你自己的数字 ID，才能在 Bot/网页批准群接入。发送 /id 获取；也可停服用 CLI 批准。
PURRAI_SUPERADMIN_IDS=[]
# 以下网页登录配置为可选；只使用 Bot 时可以留空。
PURRAI_PUBLIC_URL=http://127.0.0.1:8765
PURRAI_OIDC_CLIENT_ID=
PURRAI_OIDC_CLIENT_SECRET=
# 启用网页登录前设置至少 32 字符的随机值。
PURRAI_SESSION_SECRET=
PURRAI_COOKIE_SECURE=false
PURRAI_HOST=127.0.0.1
PURRAI_PORT=8765
PURRAI_PROXY_URL=
PURRAI_BACKUP_DIR=./data/backups

# 可选群聊天：默认 DeepSeek Flash，填 Key 后在 /admin 的“群聊天设置”中逐群开启。
# 默认关闭思考模式、使用 JSON 输出；地址与模型仍可改为其他厂商的 OpenAI 兼容接口。
PURRAI_CHAT_API_BASE=https://api.deepseek.com
PURRAI_CHAT_API_KEY=
PURRAI_CHAT_MODEL=deepseek-flash
PURRAI_CHAT_TIMEOUT=30
PURRAI_CHAT_MAX_TOKENS=256
# 可选厂商参数，覆盖自动默认值；通常保留 {} 即可。DeepSeek 的关闭思考参数会自动补入。
PURRAI_CHAT_API_EXTRA={}

# 私用聊天每日预算（北京时间零点重置），只允许服务器操作员调整。
# 所有实际模型尝试均计数，含保持安静、失败和重试；用完不影响群验证和防广告。
# 以下为 DeepSeek Flash 非思考模式的默认额度，已提高到原来的 5 倍。
# 更换模型或思考强度时可分别调整这六项；程序不按模型名称自动推算价格或改额度。
PURRAI_CHAT_DAILY_CALLS=2500
PURRAI_CHAT_GROUP_DAILY_CALLS=1000
PURRAI_CHAT_USER_DAILY_CALLS=300
PURRAI_CHAT_DAILY_TOKENS=5000000
PURRAI_CHAT_GROUP_DAILY_TOKENS=2000000
PURRAI_CHAT_USER_DAILY_TOKENS=500000
PURRAI_CHAT_USER_INTERVAL=5
PURRAI_CHAT_GROUP_INTERVAL=2
# 陌生群仅保留有限的待审批群名和ID，不归档群消息。
PURRAI_PENDING_GROUP_LIMIT=50
# 主数据库和WAL达到此容量后停止新增归档，不清除旧记录；每条消息最多保留这些版本。
PURRAI_ARCHIVE_MAX_DB_MB=512
PURRAI_ARCHIVE_MAX_REVISIONS=20

