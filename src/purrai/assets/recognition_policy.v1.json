  "output_patterns": [
    {
      "id": "management-claims",
      "title": "管理指令或冒充管理操作",
      "enabled": true,
      "pattern": "(?:^|\\s)/(?:ban|mute|unban|unmute|release|reissue)(?:@[a-z0-9_]+)?(?=\\s|$)|(?:^|[\\n。！？])\\s*[【\\[]?(?:系统|管理员|群主|官方)(?:公告|通知|指令)[】\\]]?\\s*[:：]|(?:我(?:已经?|刚刚)|已成功)(?:将|把)[^。！？\\n]{0,40}(?:禁言|封禁|踢出|移出)|(?:我(?:已经?|刚刚)|已成功)(?:永久)?(?:禁言|封禁|踢出|移出|解除了?禁言|解除了?封禁)|\\b(?:I(?:'ve| have)|successfully)\\s+(?:banned|muted|kicked|unbanned|unmuted)\\b"
    }
  ],
