{
  "utility_patterns": [
    {
      "id": "points-packet",
      "title": "积分红包口令",
      "enabled": true,
      "pattern": "(?:发)?积分红包\\s*\\d+(?:\\.\\d+)?(?:\\s+\\d+)?"
    },
    {
      "id": "points-ranking",
      "title": "积分排行口令",
      "enabled": true,
      "pattern": "积分排行"
    }
  ],
  "candidate_patterns": [
    {
      "id": "functional-phrases",
      "title": "可学习的功能口令",
      "enabled": true,
      "pattern": "(?:查询|查看|领取|兑换|刷新|我的|每日|今日|个人|群)?(?:积分|余额|金币|贡献|等级|经验|账户|背包|红包|抽奖|转盘|任务|奖励|签到|运势)(?:查询|排行|排名|明细|记录|中心|列表|商店|统计|转盘)?"
    }
  ],
  "other_bot_patterns": [
    {
      "id": "common-bot-commands",
      "title": "其他机器人的常用口令",
      "enabled": true,
      "pattern": "(?:start|help|balance|checkin)"
