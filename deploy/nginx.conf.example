# Put these zones in the existing http context, outside server blocks.
# API read/write budgets are applied per verified account by PurrAI.
# Health checks and static assets must not share the login budget.
map $uri $purrai_login_key {
    default "";
    ~^/auth/telegram/ $binary_remote_addr;
}
limit_req_zone $purrai_login_key zone=purrai_login:1m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=purrai_connections:1m;
limit_conn_zone $server_name zone=purrai_total:1m;

# Merge this server block into the existing HTTPS reverse proxy after replacing these paths.
server {
    listen 443 ssl;
    server_name purrai.example.com;
    ssl_certificate /etc/letsencrypt/live/purrai.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/purrai.example.com/privkey.pem;
    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    limit_req_status 429;
    limit_conn_status 429;
    limit_conn purrai_connections 10;
    limit_conn purrai_total 30;

    location / {
        limit_req zone=purrai_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
