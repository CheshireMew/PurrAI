  "transition": {
    "previous_keyword_rules": "通过管理入口停用原整句、组合及旧直接处罚关键词；保留记录，不与新词库同时启用。各群独立规则和覆盖也需核对。",
    "business_stages_to_disable": [
      "solicitation",
      "short",
      "profile",
      "advertising",
      "chat_solicitation",
      "chat_advertising"
    ],
    "business_rules": "读取当前business-policy，将上述阶段及其现有规则enabled改为false，保留内容和其他配置；使用读取时的If-Match保存。不要修改安装种子。",
    "shared_rules": "读取最新settings/defaults，保留非keyword规则和已有元数据，将原keyword设为停用并加入本文件rules；携带baseline保存。不要直接覆盖整份配置。",
    "ai_conditions": "沿用现有聊天开关、参与条件、冷却、额度、管理员及白名单豁免。命中关键词不等于AI已确认；未被送审或模型未确认时不执行本项处罚。",
    "endpoints": [
      "GET/PATCH /api/settings/defaults",
      "GET/PUT /api/settings/business-policy",
      "GET /api/groups/{id}/rules",
      "PUT /api/groups/{id}/rules/{rule_id}（携带 If-Match 和 Idempotency-Key）"
    ]
  },
