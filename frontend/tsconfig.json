{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "resolveJsonModule": true, "skipLibCheck": true, "esModuleInterop": true,
    "lib": ["ES2022", "DOM"], "types": ["vite/client"], "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
